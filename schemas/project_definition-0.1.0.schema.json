{
  "$comment": "Canonical decimals are strings. Numeric bounds, references and topology additionally require rcwall.validation.validate_definition; schema validation is not design compliance.",
  "$defs": {
    "BarLayoutDefinition": {
      "additionalProperties": false,
      "properties": {
        "config_id": {
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Config Id",
          "type": "string"
        },
        "distribution": {
          "discriminator": {
            "mapping": {
              "EXPLICIT": "#/$defs/ExplicitLayout",
              "LINEAR_COUNT": "#/$defs/LinearCount",
              "LINEAR_SPACING": "#/$defs/LinearSpacing"
            },
            "propertyName": "pattern"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/LinearCount"
            },
            {
              "$ref": "#/$defs/LinearSpacing"
            },
            {
              "$ref": "#/$defs/ExplicitLayout"
            }
          ],
          "title": "Distribution"
        },
        "layout_id": {
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Layout Id",
          "type": "string"
        },
        "region_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^\\S+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region Id"
        }
      },
      "required": [
        "layout_id",
        "config_id",
        "distribution"
      ],
      "title": "BarLayoutDefinition",
      "type": "object"
    },
    "BentBarDefinition": {
      "additionalProperties": false,
      "description": "Unresolved declaration: no inferred path, bend radius or hook.",
      "properties": {
        "bent_bar_id": {
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Bent Bar Id",
          "type": "string"
        },
        "definition_status": {
          "const": "UNRESOLVED",
          "title": "Definition Status",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "diameter_mm": {
          "anyOf": [
            {
              "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Diameter Mm"
        }
      },
      "required": [
        "bent_bar_id",
        "definition_status"
      ],
      "title": "BentBarDefinition",
      "type": "object"
    },
    "DrawingSpecification": {
      "additionalProperties": false,
      "properties": {
        "definition_status": {
          "const": "UNRESOLVED",
          "title": "Definition Status",
          "type": "string"
        },
        "drawing_id": {
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Drawing Id",
          "type": "string"
        },
        "drawing_scale": {
          "anyOf": [
            {
              "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Drawing Scale"
        },
        "section_id": {
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Section Id",
          "type": "string"
        },
        "template_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^\\S+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Template Id"
        }
      },
      "required": [
        "drawing_id",
        "section_id",
        "definition_status"
      ],
      "title": "DrawingSpecification",
      "type": "object"
    },
    "ExplicitBar": {
      "additionalProperties": false,
      "properties": {
        "bar_id": {
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Bar Id",
          "type": "string"
        },
        "diameter_mm": {
          "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$",
          "title": "Diameter Mm",
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/Point2D"
        }
      },
      "required": [
        "bar_id",
        "position",
        "diameter_mm"
      ],
      "title": "ExplicitBar",
      "type": "object"
    },
    "ExplicitLayout": {
      "additionalProperties": false,
      "properties": {
        "bars": {
          "items": {
            "$ref": "#/$defs/ExplicitBar"
          },
          "minItems": 1,
          "title": "Bars",
          "type": "array"
        },
        "pattern": {
          "const": "EXPLICIT",
          "title": "Pattern",
          "type": "string"
        }
      },
      "required": [
        "pattern",
        "bars"
      ],
      "title": "ExplicitLayout",
      "type": "object"
    },
    "GeometricReference": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "$ref": "#/$defs/Point2D"
        },
        "geometry_id": {
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Geometry Id",
          "type": "string"
        },
        "kind": {
          "const": "LINE",
          "title": "Kind",
          "type": "string"
        },
        "reference_id": {
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Reference Id",
          "type": "string"
        },
        "start": {
          "$ref": "#/$defs/Point2D"
        }
      },
      "required": [
        "reference_id",
        "geometry_id",
        "kind",
        "start",
        "end"
      ],
      "title": "GeometricReference",
      "type": "object"
    },
    "GeometryDefinition": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "geometry_id": {
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Geometry Id",
          "type": "string"
        },
        "shape": {
          "discriminator": {
            "mapping": {
              "POLYGON": "#/$defs/PolygonDefinition",
              "RECTANGLE": "#/$defs/RectangleDefinition"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/RectangleDefinition"
            },
            {
              "$ref": "#/$defs/PolygonDefinition"
            }
          ],
          "title": "Shape"
        }
      },
      "required": [
        "geometry_id",
        "shape"
      ],
      "title": "GeometryDefinition",
      "type": "object"
    },
    "LinearCount": {
      "additionalProperties": false,
      "properties": {
        "alignment": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alignment"
        },
        "diameter_mm": {
          "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$",
          "title": "Diameter Mm",
          "type": "string"
        },
        "end_offset_mm": {
          "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$",
          "title": "End Offset Mm",
          "type": "string"
        },
        "pattern": {
          "const": "LINEAR_COUNT",
          "title": "Pattern",
          "type": "string"
        },
        "quantity": {
          "exclusiveMinimum": 0,
          "title": "Quantity",
          "type": "integer"
        },
        "reference_id": {
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Reference Id",
          "type": "string"
        },
        "start_offset_mm": {
          "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$",
          "title": "Start Offset Mm",
          "type": "string"
        }
      },
      "required": [
        "pattern",
        "reference_id",
        "quantity",
        "diameter_mm",
        "start_offset_mm",
        "end_offset_mm"
      ],
      "title": "LinearCount",
      "type": "object"
    },
    "LinearSpacing": {
      "additionalProperties": false,
      "properties": {
        "alignment": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Alignment",
          "type": "string"
        },
        "diameter_mm": {
          "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$",
          "title": "Diameter Mm",
          "type": "string"
        },
        "end_offset_mm": {
          "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$",
          "title": "End Offset Mm",
          "type": "string"
        },
        "pattern": {
          "const": "LINEAR_SPACING",
          "title": "Pattern",
          "type": "string"
        },
        "reference_id": {
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Reference Id",
          "type": "string"
        },
        "spacing_mm": {
          "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$",
          "title": "Spacing Mm",
          "type": "string"
        },
        "spacing_policy": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Spacing Policy",
          "type": "string"
        },
        "start_offset_mm": {
          "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$",
          "title": "Start Offset Mm",
          "type": "string"
        }
      },
      "required": [
        "pattern",
        "reference_id",
        "diameter_mm",
        "spacing_mm",
        "start_offset_mm",
        "end_offset_mm",
        "spacing_policy",
        "alignment"
      ],
      "title": "LinearSpacing",
      "type": "object"
    },
    "MaterialProperty": {
      "additionalProperties": false,
      "description": "User-declared property; its name/unit do not trigger any normative interpretation.",
      "properties": {
        "name": {
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Name",
          "type": "string"
        },
        "unit": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "name",
        "value",
        "unit"
      ],
      "title": "MaterialProperty",
      "type": "object"
    },
    "MaterialSpecification": {
      "additionalProperties": false,
      "properties": {
        "properties": {
          "default": [],
          "items": {
            "$ref": "#/$defs/MaterialProperty"
          },
          "title": "Properties",
          "type": "array"
        },
        "specification": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Specification",
          "type": "string"
        }
      },
      "required": [
        "specification"
      ],
      "title": "MaterialSpecification",
      "type": "object"
    },
    "Point2D": {
      "additionalProperties": false,
      "properties": {
        "x_mm": {
          "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$",
          "title": "X Mm",
          "type": "string"
        },
        "y_mm": {
          "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$",
          "title": "Y Mm",
          "type": "string"
        }
      },
      "required": [
        "x_mm",
        "y_mm"
      ],
      "title": "Point2D",
      "type": "object"
    },
    "PolygonDefinition": {
      "additionalProperties": false,
      "description": "Implicitly closed rings. Topology and winding are checked in geometry/validation.",
      "properties": {
        "holes": {
          "default": [],
          "items": {
            "items": {
              "$ref": "#/$defs/Point2D"
            },
            "minItems": 3,
            "type": "array"
          },
          "title": "Holes",
          "type": "array"
        },
        "kind": {
          "const": "POLYGON",
          "title": "Kind",
          "type": "string"
        },
        "outer": {
          "items": {
            "$ref": "#/$defs/Point2D"
          },
          "minItems": 3,
          "title": "Outer",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "outer"
      ],
      "title": "PolygonDefinition",
      "type": "object"
    },
    "RectangleDefinition": {
      "additionalProperties": false,
      "description": "Axis-aligned rectangle with explicit lower-left origin in the local xy plane.",
      "properties": {
        "kind": {
          "const": "RECTANGLE",
          "title": "Kind",
          "type": "string"
        },
        "length_mm": {
          "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$",
          "title": "Length Mm",
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/Point2D"
        },
        "thickness_mm": {
          "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$",
          "title": "Thickness Mm",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "origin",
        "length_mm",
        "thickness_mm"
      ],
      "title": "RectangleDefinition",
      "type": "object"
    },
    "RegionDefinition": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "geometry_id": {
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Geometry Id",
          "type": "string"
        },
        "region_id": {
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Region Id",
          "type": "string"
        },
        "role": {
          "enum": [
            "BOUNDARY",
            "WEB",
            "OTHER"
          ],
          "title": "Role",
          "type": "string"
        },
        "shape": {
          "discriminator": {
            "mapping": {
              "POLYGON": "#/$defs/PolygonDefinition",
              "RECTANGLE": "#/$defs/RectangleDefinition"
